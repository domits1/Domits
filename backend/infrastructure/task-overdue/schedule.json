{
  "Name": "domits-task-overdue-rate-15-minutes",
  "Description": "Emails the assignee or host about tasks that are past their due date, twenty per run.",
  "ScheduleExpression": "rate(15 minutes)",
  "ScheduleExpressionTimezone": "Europe/Amsterdam",
  "State": "DISABLED",
  "FlexibleTimeWindow": { "Mode": "OFF" },
  "Target": {
    "Arn": "arn:aws:lambda:eu-north-1:115462458880:function:property-tasks",
    "RoleArn": "arn:aws:iam::115462458880:role/domits-task-overdue-scheduler",
    "Input": "{\"task\": \"notify-overdue-tasks\", \"limit\": 20}",
    "RetryPolicy": { "MaximumRetryAttempts": 0, "MaximumEventAgeInSeconds": 60 }
  }
}
