{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WhatThePropertyHandlerCodeUses",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminGetUser",
        "cognito-idp:GetUser",
        "dsql:DbConnect",
        "dsql:DbConnectAdmin",
        "dynamodb:BatchGetItem",
        "dynamodb:GetItem",
        "dynamodb:Query",
        "lambda:InvokeFunction",
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "ssm:GetParameter"
      ],
      "Resource": "*"
    }
  ]
}
