{
  "Name": "domits-static-page-reconciler-rate-1-hour",
  "ScheduleExpression": "rate(1 hour)",
  "State": "DISABLED",
  "FlexibleTimeWindow": {
    "Mode": "OFF"
  },
  "Target": {
    "Arn": "arn:aws:lambda:eu-north-1:115462458880:function:PropertyHandler",
    "RoleArn": "arn:aws:iam::115462458880:role/domits-static-page-worker-scheduler",
    "Input": "{\"task\": \"reconcile-static-pages\", \"limit\": 50}",
    "RetryPolicy": {
      "MaximumRetryAttempts": 0,
      "MaximumEventAgeInSeconds": 60
    }
  }
}
