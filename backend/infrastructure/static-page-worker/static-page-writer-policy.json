{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheAppShell",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__SITES_BUCKET__/index.html"
    },
    {
      "Sid": "WriteAndWithdrawPagesUnderTheirHostname",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::__SITES_BUCKET__/sites/by-host/*"
    },
    {
      "Sid": "ListPagesUnderTheHostnamePrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__SITES_BUCKET__",
      "Condition": {
        "StringLike": {
          "s3:prefix": "sites/by-host/*"
        }
      }
    },
    {
      "Sid": "NeverTouchTheShellOrTheAssets",
      "Effect": "Deny",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::__SITES_BUCKET__/index.html",
        "arn:aws:s3:::__SITES_BUCKET__/static/*",
        "arn:aws:s3:::__SITES_BUCKET__/robots.txt",
        "arn:aws:s3:::__SITES_BUCKET__/sitemap.xml"
      ]
    }
  ]
}
