-- backend/ORM/schema.psql additions

CREATE INDEX ASYNC review_status_idx_main ON main.review (status);
CREATE INDEX ASYNC review_status_idx_test ON test.review (status);

CREATE TABLE IF NOT EXISTS main.review_category (
  id VARCHAR(255) NOT NULL,
  key VARCHAR(100) NOT NULL,
  label VARCHAR(255) NOT NULL,
  description TEXT,
  review_type VARCHAR(50) NOT NULL,
  is_active BOOLEAN NOT NULL DEFAULT true,
  sort_order INT NOT NULL DEFAULT 0,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_category_key_type_unique_main
  ON main.review_category (key, review_type);

INSERT INTO main.review_category (
  id,
  key,
  label,
  description,
  review_type,
  is_active,
  sort_order,
  created_at,
  updated_at
)
VALUES
  ('main-review-category-cleanliness', 'cleanliness', 'Cleanliness', 'How clean the property was.', 'GUEST_TO_PROPERTY', true, 10, 0, 0),
  ('main-review-category-accuracy', 'accuracy', 'Accuracy', 'How accurately the listing represented the stay.', 'GUEST_TO_PROPERTY', true, 20, 0, 0),
  ('main-review-category-communication', 'communication', 'Communication', 'How clear and helpful communication was.', 'GUEST_TO_PROPERTY', true, 30, 0, 0),
  ('main-review-category-location', 'location', 'Location', 'How suitable the property location was.', 'GUEST_TO_PROPERTY', true, 40, 0, 0),
  ('main-review-category-checkin', 'checkIn', 'Check-in', 'How smooth the check-in experience was.', 'GUEST_TO_PROPERTY', true, 50, 0, 0),
  ('main-review-category-value', 'value', 'Value', 'How good the stay felt for the price.', 'GUEST_TO_PROPERTY', true, 60, 0, 0)
ON CONFLICT (key, review_type) DO UPDATE SET
  label = EXCLUDED.label,
  description = EXCLUDED.description,
  is_active = EXCLUDED.is_active,
  sort_order = EXCLUDED.sort_order,
  updated_at = EXCLUDED.updated_at;

CREATE TABLE IF NOT EXISTS main.review_request (
  id VARCHAR(255) NOT NULL,
  booking_id VARCHAR(255) NOT NULL,
  property_id VARCHAR(255) NOT NULL,
  host_id VARCHAR(255) NOT NULL,
  guest_id VARCHAR(255) NOT NULL,
  review_type VARCHAR(50) NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'OPEN',
  requested_at BIGINT NOT NULL,
  expires_at BIGINT NOT NULL,
  completed_at BIGINT,
  send_count INT NOT NULL DEFAULT 0,
  last_sent_at BIGINT,
  next_send_at BIGINT,
  claimed_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_request_booking_type_guest_unique_main
  ON main.review_request (booking_id, review_type, guest_id);

CREATE INDEX ASYNC review_request_guest_status_idx_main
  ON main.review_request (guest_id, status);

CREATE INDEX ASYNC review_request_booking_idx_main
  ON main.review_request (booking_id);

CREATE INDEX ASYNC review_request_due_main
  ON main.review_request (next_send_at, status);

CREATE TABLE IF NOT EXISTS main.review_notification_preference (
  user_id VARCHAR(255) PRIMARY KEY,
  email_enabled BOOLEAN NOT NULL DEFAULT true,
  updated_at BIGINT NOT NULL
);

CREATE TABLE IF NOT EXISTS main.review_response (
  id VARCHAR(255) NOT NULL,
  review_id VARCHAR(255) NOT NULL,
  author_id VARCHAR(255) NOT NULL,
  author_role VARCHAR(100) NOT NULL,
  message TEXT NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'draft',
  published_at BIGINT,
  deleted_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_response_review_unique_main
  ON main.review_response (review_id);
CREATE INDEX ASYNC review_response_review_status_idx_main
  ON main.review_response (review_id, status, deleted_at);

CREATE TABLE IF NOT EXISTS main.review_private_feedback (
  id VARCHAR(255) PRIMARY KEY,
  review_id VARCHAR(255) NOT NULL,
  reservation_id VARCHAR(255) NOT NULL,
  guest_id VARCHAR(255) NOT NULL,
  property_id VARCHAR(255) NOT NULL,
  feedback_type VARCHAR(100) NOT NULL,
  message TEXT NOT NULL,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL
);

CREATE INDEX ASYNC review_private_feedback_review_idx_main
  ON main.review_private_feedback (review_id, feedback_type);
CREATE INDEX ASYNC review_private_feedback_property_idx_main
  ON main.review_private_feedback (property_id, feedback_type);

CREATE TABLE IF NOT EXISTS main.review_moderation (
  id VARCHAR(255) NOT NULL,
  review_id VARCHAR(255) NOT NULL,
  target_type VARCHAR(50) NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'PENDING',
  reason VARCHAR(255),
  notes TEXT,
  moderated_by_user_id VARCHAR(255),
  moderated_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE INDEX ASYNC review_moderation_review_idx_main
  ON main.review_moderation (review_id);

CREATE INDEX ASYNC review_moderation_status_created_idx_main
  ON main.review_moderation (status, created_at);

CREATE TABLE IF NOT EXISTS main.review_verification (
  id VARCHAR(255) NOT NULL,
  review_id VARCHAR(255) NOT NULL,
  booking_id VARCHAR(255) NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'VERIFIED_STAY',
  method VARCHAR(50) NOT NULL DEFAULT 'BOOKING_MATCH',
  evidence_json TEXT,
  verified_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_verification_review_unique_main
  ON main.review_verification (review_id);

CREATE INDEX ASYNC review_verification_booking_idx_main
  ON main.review_verification (booking_id);

CREATE TABLE IF NOT EXISTS test.review_category (
  id VARCHAR(255) NOT NULL,
  key VARCHAR(100) NOT NULL,
  label VARCHAR(255) NOT NULL,
  description TEXT,
  review_type VARCHAR(50) NOT NULL,
  is_active BOOLEAN NOT NULL DEFAULT true,
  sort_order INT NOT NULL DEFAULT 0,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_category_key_type_unique_test
  ON test.review_category (key, review_type);

INSERT INTO test.review_category (
  id,
  key,
  label,
  description,
  review_type,
  is_active,
  sort_order,
  created_at,
  updated_at
)
VALUES
  ('test-review-category-cleanliness', 'cleanliness', 'Cleanliness', 'How clean the property was.', 'GUEST_TO_PROPERTY', true, 10, 0, 0),
  ('test-review-category-accuracy', 'accuracy', 'Accuracy', 'How accurately the listing represented the stay.', 'GUEST_TO_PROPERTY', true, 20, 0, 0),
  ('test-review-category-communication', 'communication', 'Communication', 'How clear and helpful communication was.', 'GUEST_TO_PROPERTY', true, 30, 0, 0),
  ('test-review-category-location', 'location', 'Location', 'How suitable the property location was.', 'GUEST_TO_PROPERTY', true, 40, 0, 0),
  ('test-review-category-checkin', 'checkIn', 'Check-in', 'How smooth the check-in experience was.', 'GUEST_TO_PROPERTY', true, 50, 0, 0),
  ('test-review-category-value', 'value', 'Value', 'How good the stay felt for the price.', 'GUEST_TO_PROPERTY', true, 60, 0, 0)
ON CONFLICT (key, review_type) DO UPDATE SET
  label = EXCLUDED.label,
  description = EXCLUDED.description,
  is_active = EXCLUDED.is_active,
  sort_order = EXCLUDED.sort_order,
  updated_at = EXCLUDED.updated_at;

CREATE TABLE IF NOT EXISTS test.review_request (
  id VARCHAR(255) NOT NULL,
  booking_id VARCHAR(255) NOT NULL,
  property_id VARCHAR(255) NOT NULL,
  host_id VARCHAR(255) NOT NULL,
  guest_id VARCHAR(255) NOT NULL,
  review_type VARCHAR(50) NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'OPEN',
  requested_at BIGINT NOT NULL,
  expires_at BIGINT NOT NULL,
  completed_at BIGINT,
  send_count INT NOT NULL DEFAULT 0,
  last_sent_at BIGINT,
  next_send_at BIGINT,
  claimed_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_request_booking_type_guest_unique_test
  ON test.review_request (booking_id, review_type, guest_id);

CREATE INDEX ASYNC review_request_guest_status_idx_test
  ON test.review_request (guest_id, status);

CREATE INDEX ASYNC review_request_booking_idx_test
  ON test.review_request (booking_id);

CREATE INDEX ASYNC review_request_due_test
  ON test.review_request (next_send_at, status);

CREATE TABLE IF NOT EXISTS test.review_notification_preference (
  user_id VARCHAR(255) PRIMARY KEY,
  email_enabled BOOLEAN NOT NULL DEFAULT true,
  updated_at BIGINT NOT NULL
);

CREATE TABLE IF NOT EXISTS test.review_response (
  id VARCHAR(255) NOT NULL,
  review_id VARCHAR(255) NOT NULL,
  author_id VARCHAR(255) NOT NULL,
  author_role VARCHAR(100) NOT NULL,
  message TEXT NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'draft',
  published_at BIGINT,
  deleted_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_response_review_unique_test
  ON test.review_response (review_id);
CREATE INDEX ASYNC review_response_review_status_idx_test
  ON test.review_response (review_id, status, deleted_at);

CREATE TABLE IF NOT EXISTS test.review_private_feedback (
  id VARCHAR(255) PRIMARY KEY,
  review_id VARCHAR(255) NOT NULL,
  reservation_id VARCHAR(255) NOT NULL,
  guest_id VARCHAR(255) NOT NULL,
  property_id VARCHAR(255) NOT NULL,
  feedback_type VARCHAR(100) NOT NULL,
  message TEXT NOT NULL,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL
);

CREATE INDEX ASYNC review_private_feedback_review_idx_test
  ON test.review_private_feedback (review_id, feedback_type);
CREATE INDEX ASYNC review_private_feedback_property_idx_test
  ON test.review_private_feedback (property_id, feedback_type);

CREATE TABLE IF NOT EXISTS test.review_moderation (
  id VARCHAR(255) NOT NULL,
  review_id VARCHAR(255) NOT NULL,
  target_type VARCHAR(50) NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'PENDING',
  reason VARCHAR(255),
  notes TEXT,
  moderated_by_user_id VARCHAR(255),
  moderated_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE INDEX ASYNC review_moderation_review_idx_test
  ON test.review_moderation (review_id);

CREATE INDEX ASYNC review_moderation_status_created_idx_test
  ON test.review_moderation (status, created_at);

CREATE TABLE IF NOT EXISTS test.review_verification (
  id VARCHAR(255) NOT NULL,
  review_id VARCHAR(255) NOT NULL,
  booking_id VARCHAR(255) NOT NULL,
  status VARCHAR(50) NOT NULL DEFAULT 'VERIFIED_STAY',
  method VARCHAR(50) NOT NULL DEFAULT 'BOOKING_MATCH',
  evidence_json TEXT,
  verified_at BIGINT,
  created_at BIGINT NOT NULL,
  updated_at BIGINT NOT NULL,
  PRIMARY KEY (id)
);

CREATE UNIQUE INDEX ASYNC review_verification_review_unique_test
  ON test.review_verification (review_id);

CREATE INDEX ASYNC review_verification_booking_idx_test
  ON test.review_verification (booking_id);
