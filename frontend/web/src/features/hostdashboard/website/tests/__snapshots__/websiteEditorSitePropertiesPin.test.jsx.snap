exports[`the website editor of a host without multi-property renders the same page as before, whatever the plan read answers 1`] = `"<main class=\\"page-Host\\"><div class=\\"page-Host-content\\"><section class=\\"editorPage\\"><div class=\\"heroCard\\"><p class=\\"eyebrow\\">Direct booking website editor</p><div class=\\"heroHeader\\"><div><h1 class=\\"heroTitle\\">Wellness Villa Bisous</h1><p class=\\"heroDescription\\">Manage the saved website, refine its content and presentation, and publish updates to the Domits live link.</p></div></div><div class=\\"buttonRow heroActionRow\\"><button type=\\"button\\" class=\\"secondaryButton\\"><svg class=\\"MuiSvgIcon-root MuiSvgIcon-fontSizeSmall css-120dh41-MuiSvgIcon-root\\" focusable=\\"false\\" aria-hidden=\\"true\\" viewBox=\\"0 0 24 24\\" data-testid=\\"ArrowBackIcon\\"><path d=\\"M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z\\"></path></svg>Back to website workspace</button><div class=\\"actionMenuContainer\\"><button type=\\"button\\" class=\\"primaryButton\\" aria-haspopup=\\"menu\\" aria-expanded=\\"false\\"><span>Publish website</span> <img src=\\"arrow-down-icon.svg\\" alt=\\"\\" aria-hidden=\\"true\\" class=\\"actionMenuButtonIcon\\"></button><div class=\\"actionMenuList\\" role=\\"menu\\" aria-label=\\"Website update actions\\" aria-hidden=\\"true\\"><button type=\\"button\\" role=\\"menuitem\\" class=\\"actionMenuItem\\"><svg class=\\"MuiSvgIcon-root MuiSvgIcon-fontSizeSmall css-120dh41-MuiSvgIcon-root\\" focusable=\\"false\\" aria-hidden=\\"true\\" viewBox=\\"0 0 24 24\\" data-testid=\\"PublicOutlinedIcon\\"><path d=\\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2M4 12c0-.61.08-1.21.21-1.78L8.99 15v1c0 1.1.9 2 2 2v1.93C7.06 19.43 4 16.07 4 12m13.89 5.4c-.26-.81-1-1.4-1.9-1.4h-1v-3c0-.55-.45-1-1-1h-6v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41C17.92 5.77 20 8.65 20 12c0 2.08-.81 3.98-2.11 5.4\\"></path></svg>Publish live site</button><button type=\\"button\\" role=\\"menuitem\\" class=\\"actionMenuItem actionMenuItemDestructive\\">Discard all changes</button></div></div></div><section class=\\"publicSitePanel\\"><div class=\\"publicSiteHeader\\"><div><h2 class=\\"publicSiteTitle\\">Live site</h2><p class=\\"publicSiteDescription\\">Publish creates the Domits live link. Update applies the latest editor changes to the public website.</p></div></div><div class=\\"publicSiteGrid\\"><div class=\\"publicSiteMetric\\"><span class=\\"publicSiteLabel\\">Internal preview link</span><a class=\\"publicSiteLink publicSiteValueLink\\" href=\\"/website-preview/draft-1\\" target=\\"_blank\\" rel=\\"noreferrer\\"><strong class=\\"publicSiteValue\\">/website-preview/draft-1</strong></a></div><div class=\\"publicSiteMetric\\"><span class=\\"publicSiteLabel\\">Link status</span><strong class=\\"publicSiteValue\\">Not published</strong></div><div class=\\"publicSiteMetric\\"><span class=\\"publicSiteLabel\\">Publication status</span><strong class=\\"publicSiteValue\\">Not published</strong></div></div><p class=\\"publicSiteHint\\">Publish the website once to generate its Domits live link.</p></section></div><div class=\\"surface\\"><aside class=\\"editorPanel\\"><div class=\\"panelHeader\\"><h2 class=\\"panelTitle\\">Editor</h2></div><div class=\\"editorForm\\"><section class=\\"panelSection\\"><button type=\\"button\\" class=\\"sectionToggle\\" aria-expanded=\\"false\\"><div class=\\"sectionBlockHeader\\"><h3 class=\\"sectionBlockTitle\\">Hero</h3><p class=\\"sectionBlockDescription\\">Control the top-of-page copy, hero image, and template-specific hero settings.</p></div><img src=\\"arrow-down-icon.svg\\" alt=\\"\\" aria-hidden=\\"true\\" class=\\"sectionToggleIcon\\"></button><div class=\\"panelSectionBody\\" aria-hidden=\\"true\\"><div class=\\"panelSectionBodyInner\\"><div class=\\"imageSlotGrid\\"><div class=\\"imageSlotCard\\"><div class=\\"imageSlotPreview\\"><img src=\\"https://accommodation.s3.eu-north-1.amazonaws.com/images/ecd926d9-67dc-4d0a-9b4